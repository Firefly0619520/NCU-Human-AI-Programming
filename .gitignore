# =========================================================
#  .gitignore  —  告诉 Git 哪些文件不需要纳入版本管理
#  说明：被忽略的文件不会上传到 GitHub（如缓存、密钥、临时文件）
# =========================================================

# ---------- 操作系统 / 编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
*.code-workspace

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
pip-log.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------- Node.js / 前端 ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
.next/
.cache/
coverage/

# ---------- 环境变量 / 密钥（重要：切勿上传） ----------
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# ---------- 数据 / 输出 / 日志 ----------
*.log
*.tmp
*.bak
data/raw/
output/
results/*.png

# ---------- 编译产物 / 二进制 ----------
*.exe
*.dll
*.o
*.obj
*.class
*.pyc
